# ==========================================
# CodeCompass Configuration
# ==========================================

# AI Copilot Provider (Optional - works offline if omitted)
# Supported: gemini, openrouter
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# ==========================================
# Email & Password Reset Dispatch (Optional)
# If omitted, password reset recovery codes are logged strictly to the host server console.
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CodeCompass Security <security@codecompass.dev>
SMTP_USE_TLS=true
